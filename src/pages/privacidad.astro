---
import Legal from '../layouts/Legal.astro';
import site from '../data/site.json';
import { mark } from '../lib/text';
const m = mark;
const rows = [
  ['Gestionar su reserva o solicitud de evento', 'Ejecución de medidas precontractuales o del contrato (art. 6.1.b RGPD)', `Hasta la prestación del servicio y ${site.dataRetention} después`],
  ['Atender consultas', 'Consentimiento (art. 6.1.a RGPD)', 'El tiempo necesario para atenderla'],
  ['Tratar alergias o intolerancias que usted indique', 'Consentimiento explícito (art. 9.2.a RGPD)', 'Hasta la prestación del servicio'],
  ['Obligaciones fiscales y contables', 'Obligación legal (art. 6.1.c RGPD)', 'Plazos legales vigentes'],
  ['Comunicaciones comerciales (solo si las acepta)', 'Consentimiento (art. 6.1.a RGPD)', 'Hasta que retire el consentimiento'],
];
---
<Legal title="Política de privacidad · Áurea" h1="Política de privacidad" crumb="Privacidad" description="Cómo trata Áurea los datos de reservas, eventos y consultas: responsable, finalidades, base jurídica, plazos y sus derechos según el RGPD.">
  <h2>Responsable del tratamiento</h2>
  <p set:html={`${m(site.legalName)}, NIF ${m(site.nif)}, ${m(site.address.full)}, ${m(site.email)}. ${m('[Delegado de protección de datos, si procede.]')}`} />
  <h2>Qué datos tratamos</h2>
  <p>Los que usted facilita en los formularios de reserva, eventos y contacto: nombre, correo, teléfono, fecha y número de comensales, ocasión, alergias o intolerancias y el contenido de su mensaje.</p>
  <h2>Para qué los usamos y con qué base legal</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Finalidad</th><th scope="col">Base jurídica</th><th scope="col">Plazo de conservación</th></tr></thead>
      <tbody>
        {rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td set:html={m(r[2])} /></tr>)}
      </tbody>
    </table>
  </div>
  <h2>Destinatarios</h2>
  <p set:html={`No cedemos sus datos a terceros salvo obligación legal. Pueden acceder proveedores que prestan servicios por cuenta del titular: ${m(site.providers.reservations)}, ${m(site.providers.hosting)}, ${m(site.providers.mail)}, con contrato de encargado del tratamiento. ${m('[Indicar si hay transferencias internacionales y sus garantías.]')}`} />
  <h2>Sus derechos</h2>
  <p set:html={`Puede ejercer los derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a ${m(site.email)}, con copia de su documento de identidad. Puede retirar su consentimiento en cualquier momento y reclamar ante la Agencia Española de Protección de Datos (<a href="https://www.aepd.es" rel="noopener" target="_blank">www.aepd.es</a>).`} />
  <h2>Menores</h2>
  <p>Este sitio no está dirigido a menores de 14 años.</p>
</Legal>
