---
import LineArt from './LineArt.astro';
/**
 * Fotografía con dirección de arte.
 * Mientras no haya foto real (prop `src`), muestra un marcador oscuro y cálido
 * con un dibujo de línea dorada y la indicación de qué foto va en ese hueco.
 */
interface Props {
  ratio?: '4:5' | '3:2' | '1:1' | '16:9' | '2:3';
  art?: 'plate' | 'glass' | 'candle' | 'room' | 'knife' | 'bottle' | 'fish' | 'sprout' | 'toast';
  brief: string;
  alt: string;
  src?: string;
  srcset?: string;
  sizes?: string;
  width?: number;
  height?: number;
  eager?: boolean;
  parallax?: boolean;
  light?: string;
  class?: string;
}
const {
  ratio = '4:5', art = 'plate', brief, alt, src, srcset, sizes, width, height,
  eager = false, parallax = true, light = '50% 40%', class: cls = '',
} = Astro.props;
const [lx, ly] = light.split(' ');
---
<figure class={`photo ${cls}`} data-ratio={ratio} data-photo data-parallax={parallax ? '' : undefined} style={`--lx:${lx};--ly:${ly}`}>
  <div class="photo__media">
    {src ? (
      <img src={src} srcset={srcset} sizes={sizes} alt={alt} width={width} height={height}
        loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
    ) : (
      <div class="photo__art" role="img" aria-label={alt}>
        <LineArt art={art} />
      </div>
    )}
  </div>
  {!src && <figcaption class="photo__tag">Foto {ratio} · {brief}</figcaption>}
</figure>
